// HookRelay 스키마 — foundation: 테넌트·API 키·수신 endpoint·구독
// 설계 원칙: 원문 비밀값은 저장하지 않는다(키는 해시, 시크릿은 AES-GCM 암호문).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantPlan {
  FREE
  PRO
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(100)
  plan      TenantPlan   @default(FREE)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  apiKeys   ApiKey[]
  endpoints Endpoint[]
  events    Event[]

  @@map("tenants")
}

enum ApiKeyStatus {
  ACTIVE
  GRACE
  REVOKED
}

model ApiKey {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @map("tenant_id") @db.Uuid
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  // 원문 미저장 — SHA-256 hex. 발급 응답에서 단 한 번만 노출된다.
  keyHash  String       @unique @map("key_hash") @db.Char(64)
  last4    String       @db.Char(4)
  status   ApiKeyStatus @default(ACTIVE)
  // GRACE 키의 만료 시각 — 회전 후 24시간 유예
  expiresAt DateTime?   @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("api_keys")
}

enum EndpointStatus {
  ACTIVE
  DISABLED_AUTO
  DISABLED_MANUAL
}

model Endpoint {
  id       String         @id @default(uuid()) @db.Uuid
  tenantId String         @map("tenant_id") @db.Uuid
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  url      String         @db.VarChar(500)
  // HMAC 서명 시크릿 — AES-256-GCM 앱 레벨 암호화(v1:iv:tag:data). 마스터 키는 환경변수.
  secretEnc String        @map("secret_enc") @db.VarChar(300)
  status   EndpointStatus @default(ACTIVE)
  description String?     @db.VarChar(200)
  // 서킷 브레이커·자동 비활성화 판단용 (배달 단계에서 갱신)
  consecutiveFailures Int @default(0) @map("consecutive_failures")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]
  deliveries    Delivery[]

  @@unique([tenantId, url])
  @@index([tenantId])
  @@map("endpoints")
}

model Subscription {
  id         BigInt   @id @default(autoincrement())
  endpointId String   @map("endpoint_id") @db.Uuid
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  // 점 표기 이벤트 타입 — 'order.created'
  eventType  String   @map("event_type") @db.VarChar(100)

  @@unique([endpointId, eventType])
  @@map("subscriptions")
}

// ── 이벤트 발행 · Transactional Outbox ──────────────────────────────
// events / deliveries / outbox는 발행 API의 "같은 트랜잭션"에서 함께 쓰인다.
// DB 커밋 = 배달 예약 확정. 큐(Redis)는 이 기록의 파생물일 뿐이다.

// 발행된 이벤트 — 불변. id는 수신자에게도 노출되는 배달 멱등성의 근거.
model Event {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  type           String   @db.VarChar(100)
  payload        Json     @db.JsonB
  // 발행 멱등성 — 같은 (tenant, key) 재시도는 409 + 기존 eventId 반환
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  deliveries Delivery[]
  outbox     OutboxMessage[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("events")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
}

// 발행-적재 원자성의 핵심 — events와 같은 트랜잭션으로 INSERT되고,
// Relay가 PENDING 행을 폴링해 큐 적재 후 PUBLISHED로 마킹한다.
// 부분 인덱스 (id) WHERE status='PENDING'은 마이그레이션 SQL에서 직접 생성.
model OutboxMessage {
  id          BigInt       @id @default(autoincrement())
  eventId     String       @map("event_id") @db.Uuid
  event       Event        @relation(fields: [eventId], references: [id])
  status      OutboxStatus @default(PENDING)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("outbox")
}

enum DeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED_RETRYING
  DEAD
}

// 이벤트 × endpoint 배달 단위 — id가 X-Delivery-Id로 전달되는 소비자 멱등성 키.
model Delivery {
  id           String         @id @default(uuid()) @db.Uuid
  eventId      String         @map("event_id") @db.Uuid
  event        Event          @relation(fields: [eventId], references: [id])
  endpointId   String         @map("endpoint_id") @db.Uuid
  endpoint     Endpoint       @relation(fields: [endpointId], references: [id])
  status       DeliveryStatus @default(PENDING)
  attemptCount Int            @default(0) @map("attempt_count")
  // 조회용 스냅샷 — 실제 재시도 스케줄은 BullMQ 지연 잡이 담당
  nextRetryAt  DateTime?      @map("next_retry_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 팬아웃 중복 생성 차단
  @@unique([eventId, endpointId])
  @@index([endpointId, status])
  @@map("deliveries")
}
