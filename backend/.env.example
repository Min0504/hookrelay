# PostgreSQL (docker-compose.dev.yml)
DATABASE_URL=postgresql://hookrelay:hookrelay@localhost:55434/hookrelay

# 관리자 API 키 — POST /tenants 전용 (데모 편의용 단일 키)
HR_ADMIN_KEY=dev-admin-key-change-me

# endpoint 시크릿 암호화 마스터 키 — base64 인코딩된 32바이트
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HR_SECRET_KEY=3W9lJ4vGml7C0S3M0Yl8mB6t1IhU4d0T9S8kR2c5x6A=

# SSRF 방어 완화 플래그 — 로컬 데모에서 http/사설 IP endpoint 허용 (운영 금지)
HR_ALLOW_INSECURE_HTTP=true
HR_ALLOW_PRIVATE_DESTINATIONS=false

PORT=3000

# Redis — BullMQ 큐 (docker-compose.dev.yml). API 서버는 연결하지 않고 Relay/Worker만 사용
REDIS_URL=redis://localhost:63790

# outbox 폴링 주기(ms) — 배달 지연 상한
HR_OUTBOX_POLL_MS=500

# 배달 HTTP 타임아웃(ms) — 2xx 외 응답/타임아웃은 실패
HR_DELIVERY_TIMEOUT_MS=10000

# 워커 프로세스당 동시 배달 수
HR_WORKER_CONCURRENCY=10
